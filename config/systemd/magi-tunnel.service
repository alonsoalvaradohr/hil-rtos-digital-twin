[Unit]
Description=MAGI Resilient Cloudflare Tunnel (Permanent Named / Quick Fallback -> :8088)
After=network-online.target nginx.service magi-ui.service
Wants=network-online.target

[Service]
Type=simple
User=alonso
Group=alonso
ExecStart=/usr/local/bin/magi-tunnel-launcher.sh
ExecStartPost=/home/alonso/extract_magi_url.sh
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magi-tunnel

[Install]
WantedBy=multi-user.target
