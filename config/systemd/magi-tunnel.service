[Unit]
Description=MAGI Cloudflare Quick Tunnel (trycloudflare.com -> :8088)
After=network-online.target nginx.service magi-ui.service
Wants=network-online.target

[Service]
Type=simple
User=alonso
Group=alonso
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8088 --no-autoupdate
ExecStartPost=/home/alonso/extract_magi_url.sh
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magi-tunnel

[Install]
WantedBy=multi-user.target
