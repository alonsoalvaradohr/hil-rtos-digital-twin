# ==============================================================================
# HIL-RTOS DIGITAL TWIN - ENVIRONMENT TEMPLATE (PUBLIC REPOSITORY SAFE)
# ==============================================================================
# Copie este archivo como .env.local para configurar credenciales locales.
# .env.local esta estrictamente ignorado por .gitignore y NUNCA se sube a GitHub.

# Credenciales de Enlace SSH Target
HIL_SSH_HOST=target-device.local
HIL_SSH_USER=operator
HIL_SSH_KEY_PATH=~/.ssh/id_ed25519_hil
HIL_SUDO_PASS=

# Configuracion de Red y Broker MQTT
HIL_MQTT_BROKER=127.0.0.1
HIL_MQTT_PORT=1883

# Configuracion de Compositor Kiosk y Display
HIL_DISPLAY_RES=1024x600
HIL_DRM_CONNECTOR=HDMI-A-1
