cff-version: 1.2.0
message: "If you use HIL-RTOS Digital Twin in your research, experiments, or real-time robotics architectures, please cite it as below."
title: "HIL-RTOS Digital Twin & Real-Time Hypervisor (Raspberry Pi 5 PREEMPT_RT)"
version: "1.0.0"
date-released: "2026-11-25"
license: "GPL-3.0-or-later"
repository-code: "https://github.com/alonsoalvaradohr/hil-rtos-digital-twin"
authors:
  - family-names: "Alvarado Hernández"
    given-names: "Alonso"
    alias: "alonsoalvaradohr"
abstract: "HIL-RTOS Digital Twin is a deterministic hardware-in-the-loop (HIL) digital twin, real-time hypervisor, and low-latency IPC framework engineered for Raspberry Pi 5 with PREEMPT_RT kernel extensions, lock-free IPC, and synchronized telemetry."
keywords:
  - "rtos"
  - "preempt-rt"
  - "raspberry pi 5"
  - "digital twin"
  - "hardware-in-the-loop"
  - "lock-free"
  - "ipc"
  - "robotics"
