[Unit]
Description=MAGI Wayland Kiosk Compositor (Core 1 - Interactive Labwc)
After=network.target systemd-user-sessions.service magi-ui.service seatd.service
Wants=magi-ui.service seatd.service

[Service]
User=alonso
Group=alonso
SupplementaryGroups=video input render tty dialout bluetooth
StandardInput=null
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=WLR_BACKENDS=drm,libinput
Environment=WLR_RENDERER=gles2
Environment=LIBSEAT_BACKEND=seatd
Environment=SEATD_VTBOUND=0
Environment=XDG_SESSION_TYPE=wayland
Environment=XCURSOR_SIZE=24
Environment=XCURSOR_THEME=Adwaita
ExecStartPre=/bin/rm -rf /tmp/chromium_magi_profile/Singleton*
ExecStart=/usr/bin/labwc -s "/usr/bin/chromium-browser --no-sandbox --disable-setuid-sandbox --kiosk --noerrdialogs --disable-infobars --no-first-run --no-default-browser-check --disable-session-crashed-bubble --disable-extensions --disable-background-networking --disable-sync --disable-translate --metrics-recording-only --no-service-autorun --remote-debugging-port=9222 --ozone-platform=wayland --enable-features=UseOzonePlatform,WaylandWindowDecorations,TouchTextSelection --touch-events=enabled --disable-pinch --user-data-dir=/tmp/chromium_magi_profile http://127.0.0.1:8080/"
Restart=always
RestartSec=2s
CPUAffinity=1

[Install]
WantedBy=graphical.target
