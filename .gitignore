# --- Secretos y Credenciales (EPSILON: veto absoluto) ---
.env
.env.*
*.secret
*.key
*.pem
*.p12
*.pfx
secrets/
vault/
credentials/

# --- Datos Volátiles de Introspección (regenerables con introspect.py) ---
Digital_Twin_Workspace/raw_introspection.json

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
pip-log.txt

# --- PlatformIO (firmware embebido) ---
.pio/
.pioenvs/
.piolibdeps/

# --- Node.js / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
.npm/

# --- Bases de datos locales ---
*.sqlite
*.sqlite3
*.db

# --- Logs y temporales ---
*.log
logs/
tmp/
temp/

# --- IDE y Sistema Operativo ---
.vscode/settings.json
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
desktop.ini

# --- Artefactos de compilación C/C++ ---
*.o
*.a
*.so
*.elf
*.bin
*.hex
*.map

# --- SSH (nunca en repositorio) ---
id_rsa
id_ed25519
id_ecdsa
known_hosts
authorized_keys